# ExternalSecret — instructs ESO to pull the SM secret and create a K8s Secret.
#
# ESO reads every key from the JSON blob in AWS Secrets Manager and maps them
# 1-to-1 into the K8s Secret called "db-secret". The Tomcat and MySQL pods
# consume this Secret via envFrom → secretRef as before.
#
# refreshInterval: ESO re-syncs every hour. If you rotate the password in SM,
# Kubernetes automatically gets the new value within 1 hour — no redeployment.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: db-external-secret
  namespace: default
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: db-secret          # name of the K8s Secret ESO will create/own
    creationPolicy: Owner    # ESO owns the secret — deletes it when ExternalSecret is deleted
  dataFrom:
    - extract:
        key: {{ secret_name }}   # AWS SM secret name, e.g. event-app/db-credentials
