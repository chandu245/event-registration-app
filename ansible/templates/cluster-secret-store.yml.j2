# ClusterSecretStore — tells ESO where to find secrets (AWS Secrets Manager)
# and which IAM identity to use (the IRSA role on the ESO service account).
#
# ClusterSecretStore is cluster-scoped so ExternalSecrets in any namespace
# can reference it — unlike SecretStore which is namespace-scoped.
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: aws-secrets-manager
spec:
  provider:
    aws:
      service: SecretsManager
      region: {{ aws_region }}
      auth:
        jwt:
          serviceAccountRef:
            name: external-secrets
            namespace: external-secrets
