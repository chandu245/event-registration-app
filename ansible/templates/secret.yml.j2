# Kubernetes Secret populated at deploy time from AWS Secrets Manager.
# Credentials are never stored in Jenkins or this repo.
# Source of truth: AWS Secrets Manager secret "{{ secret_name }}"
apiVersion: v1
kind: Secret
metadata:
  name: db-secret
  namespace: default
  annotations:
    managed-by: "ansible"
    aws-secret-name: "{{ secret_name }}"
type: Opaque
stringData:
  DB_URL: "{{ db_secret.DB_URL }}"
  DB_USER: "{{ db_secret.DB_USER }}"
  DB_PASS: "{{ db_secret.DB_PASS }}"
  MYSQL_ROOT_PASSWORD: "{{ db_secret.MYSQL_ROOT_PASSWORD }}"
  MYSQL_DATABASE: "{{ db_secret.MYSQL_DATABASE }}"
  MYSQL_USER: "{{ db_secret.MYSQL_USER }}"
  MYSQL_PASSWORD: "{{ db_secret.MYSQL_PASSWORD }}"
