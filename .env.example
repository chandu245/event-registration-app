# Local development environment variables.
# Copy this file to .env and set real values — .env is gitignored and never committed.
#
# Used only for local `docker compose up` testing.
# Production credentials are auto-generated by Terraform (random_password) and
# stored in AWS Secrets Manager — never set by a human.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=eventdb
MYSQL_USER=eventuser
MYSQL_PASSWORD=change-this-app-password
